# Nginx Document Root (relatif terhadap root project, misal ./www, atau path absolut)
NGINX_WEB_ROOT=./www
# Default PHP version untuk http://localhost:8080 (pilihan: 5.6 / 7.4 / 8.2 / 8.3 / 8.4)
DEFAULT_PHP_VERSION=8.4
# Port MariaDB stack ini (3306 kalau bebas; 3307 jika MySQL/MariaDB lain sudah jalan)
MARIADB_PORT=3307
MARIADB_ROOT_PASSWORD=root
